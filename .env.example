# Copy to .env before running docker compose.
# Host port exposed by docker compose.
ID_DOC_OCR_PORT=8000

# Runtime options passed to the API process.
ID_DOC_OCR_HOST=0.0.0.0
ID_DOC_OCR_API_PORT=8000
ID_DOC_OCR_LOG_LEVEL=info

# Base image override for environments where Docker Hub auth/pulls are flaky.
# Leave the default for normal usage. If python:3.11-slim is already cached locally,
# you can tag it as local/python:3.11-slim and set this to that local tag.
ID_DOC_OCR_PYTHON_BASE_IMAGE=python:3.11-slim-bookworm

# Optional APT mirror override for slow or unstable Debian mirrors during docker build.
# Good candidates validated on this machine: Tsinghua Tuna and Aliyun.
ID_DOC_OCR_APT_MIRROR=http://deb.debian.org/debian
ID_DOC_OCR_APT_SECURITY_MIRROR=http://deb.debian.org/debian-security

# Optional proxy passthrough for docker build/runtime. Leave empty if Docker Desktop
# already injects proxies at the daemon level.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
no_proxy=

# Optional pip mirror override for faster Python dependency downloads during docker build.
# Use HTTPS mirrors when possible.
ID_DOC_OCR_PIP_INDEX_URL=https://pypi.org/simple
ID_DOC_OCR_PIP_EXTRA_INDEX_URL=
ID_DOC_OCR_PIP_TRUSTED_HOST=

# Build-time toggle: 1 installs PaddleOCR + PaddlePaddle inside the image.
# Set to 0 if you need a lighter rapidocr-first image.
ID_DOC_OCR_INSTALL_PADDLE=1

# Runtime defaults for real trial usage.
# Full image: paddleocr + pil detector/rectify is the recommended path.
# If you set ID_DOC_OCR_INSTALL_PADDLE=0, also switch ID_DOC_OCR_DEFAULT_OCR_BACKEND=rapidocr.
ID_DOC_OCR_DEFAULT_OCR_BACKEND=paddleocr
ID_DOC_OCR_DEFAULT_VLM_BACKEND=mock
ID_DOC_OCR_DEFAULT_DETECTOR_BACKEND=pil
ID_DOC_OCR_DEFAULT_RECTIFY_BACKEND=pil

# Host port exposed by the static UI container.
ID_DOC_OCR_UI_PORT=8080

# Directory mounted into the container for failed samples / diagnostics.
ID_DOC_OCR_FAILURE_DIR=./data/failures
